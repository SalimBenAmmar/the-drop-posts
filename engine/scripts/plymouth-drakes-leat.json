   }
  },
  {
   "text": "Drake was the contractor, and he got leases for six water mills along it.",
   "gap": 0.3,
   "caps": [
    "DRAKE WAS THE *CONTRACTOR",
    "*SIX WATER MILLS"
   ],
   "scene": {
