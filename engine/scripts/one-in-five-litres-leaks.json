            "l": "LESS LEAKAGE SINCE 2017–18",
            "red": false
          }
        ],
        "source": "ENVIRONMENT AGENCY 2025–26"
      }
    },
    {
      "text": "That's only about one and a half per cent a year.",
      "gap": 0.3,
      "caps": [
        "ONLY *1.5%",
