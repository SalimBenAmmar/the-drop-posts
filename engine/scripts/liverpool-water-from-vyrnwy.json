            null
          ]
        ]
      }
    },
    {
      "text": "It's called Lake Vyrnwy, in the hills of mid Wales.",
      "gap": 0.3,
      "caps": [
        "*LAKE VYRNWY",
        "MID *WALES"
      ],
      "scene": {
        "type": "map",
        "cam": [
